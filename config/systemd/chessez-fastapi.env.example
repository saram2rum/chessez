STOCKFISH_PATH=/usr/games/stockfish
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
FRONTEND_DIR=frontend
AI_MAX_CONCURRENT=3
AI_ENGINE_THREADS=2
AI_ENGINE_HASH_MB=16
AI_MOVE_MAX_TIME_MS=800
AI_EVAL_MIN_SEARCH_MS=50
AI_EVAL_MAX_SEARCH_MS=2000
DEFAULT_TIME_LIMIT_SEC=600
DEFAULT_INCREMENT_SEC=0
MAX_ACTIVE_ROOMS=50
MAX_ACTIVE_CONNECTIONS=50
WAITING_ROOM_TTL_SEC=1800
FINISHED_ROOM_TTL_SEC=300
# Playing room: delete after this many seconds with zero WebSockets (default 60 if unset)
PLAYING_ROOM_DISCONNECT_TTL_SEC=60
# Partial disconnect: opponent wins after this many ms with no reconnect (default 60s if unset)
ABANDONMENT_GRACE_MS=60000
